# -----------------------------------------------------------------------------
# Foundathyon accounts-admin — environment template
# -----------------------------------------------------------------------------
# This file documents every env var the app reads. It is committed on purpose.
# Real values live in `.envs/.env.local` / `.env.mock` / `.env.dev` / `.env.prod`
# / `.env.staging`, none of which are tracked (see repo `.gitignore`).
#
# Loading order (see `load-envs.ts`):
#   1. `.envs/.env.base`             → defines ENVIRONMENT
#   2. `.envs/.env.<environment>`    → per-env values, `override: true`
#
# ENVIRONMENT values → file:
#   local        → .env.local
#   mock         → .env.mock
#   development  → .env.dev
#   production   → .env.prod
#   staging      → .env.staging
#
# To bootstrap:  cp .envs/.env.example .envs/.env.local  (or .env.mock, etc.)
# -----------------------------------------------------------------------------

# --- Accounts backend ---------------------------------------------------------
# Base URL of the Go accounts API this admin proxies to. Read server-side only
# (see `src/lib/utils.ts` → `INTERNAL_API_URL`). Default: http://localhost:8000/accounts
INTERNAL_API_URL=http://localhost:8001/accounts

# Server-side admin-scoped API key. Forwarded to backend as `X-Admin-API-Key`
# by `requireAdminKey()` in `src/lib/accounts-api.ts`. Required for
# `/api/apps` (GET/POST) and everything under `/api/system/*`. Default: `secret`.
ADMIN_API_KEY=secret

# --- Admin panel login (single user) ------------------------------------------
# Credentials checked by `/api/admin/login`. Anyone with the cookie has full
# admin power (no role model inside the admin). Defaults: admin / changeme.
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# HMAC secret used to sign the `admin_session` cookie. If unset, the admin
# falls back to ADMIN_PASSWORD, then to `'change-me-in-production'`. Set this
# to a long random string in real deployments.
ADMIN_SESSION_SECRET=change-me-in-production

# Session lifetime in SECONDS. Default 86400 (1 day).
SESSION_TTL=86400

# --- Optional: BASE_PATH for reverse-proxy hosting ----------------------------
# When the admin is hosted under a sub-path (e.g. /admin), set BOTH to that path.
# In Docker, the build bakes a placeholder that `entrypoint.sh` rewrites at
# runtime — leave these empty in that flow.
BASE_PATH=
NEXT_PUBLIC_BASE_PATH=

# --- Optional: auto-seed the admin UI's client API keys -----------------------
# When set, the admin UI stores these in localStorage on first login so the
# operator skips onboarding. `NEXT_PUBLIC_*` variables are inlined into the
# client bundle — never put a real production secret here.
NEXT_PUBLIC_DEV_SECRET_KEY=
NEXT_PUBLIC_DEV_PUBLISHABLE_KEY=

# --- Mock server toggle (only for the mock backend) ---------------------------
# Set MOCK_NO_APPS=1 when running `make dev-mock` to start the mock with zero
# apps registered, so you can walk through the admin onboarding flow.
# MOCK_NO_APPS=1

# --- Mock server port (only for the mock backend) -----------------------------
# Defaults to 8099 (see mock-server/server.ts). Override if 8099 is taken.
# MOCK_PORT=8099
